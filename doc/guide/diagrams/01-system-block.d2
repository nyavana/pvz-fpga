direction: right
title: "DE1-SoC System Block Diagram" {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

board: "Terasic DE1-SoC board (Cyclone V SoC)" {
  style.fill: "#f5f5f5"
  style.stroke: "#333"
  style.stroke-width: 2

  hps: "Hard Processor System (HPS)" {
    style.fill: "#cfe2ff"
    arm: "Dual-core ARM\nCortex-A9 @ ~925 MHz"
    linux: "Linux 4.19 (Yocto)"
    ddr: "DDR3 SDRAM\n1 GB"
    sd: "SD card\n(rootfs + bitstream)"
    usb: "USB-OTG\n(keyboard / gamepad)"
    uart: "UART\n(serial console)"
  }

  fabric: "FPGA fabric" {
    style.fill: "#d1e7dd"
    pvz: "pvz_top\n(custom GPU peripheral)" {
      style.fill: "#a3cfbb"
    }
    vga_pins: "VGA DAC pins\n(R/G/B 8-bit + sync)" {
      style.fill: "#a3cfbb"
    }
  }

  bridge: "Lightweight HPS-to-FPGA bridge\n(Avalon-MM, base 0xff200000)" {
    style.fill: "#fff3cd"
    style.font-size: 12
  }

  hps -> bridge: "ioctl write\n(iowrite32)"
  bridge -> fabric.pvz: "32-bit writes\n(Avalon-MM)"
  fabric.pvz -> fabric.vga_pins: "640x480 @ 60 Hz\n(R, G, B, HS, VS)"
}

vga: "VGA monitor\n(640x480)" {
  style.fill: "#ffe5d0"
  shape: cylinder
}

input: "USB keyboard\n+ Xbox 360 gamepad" {
  style.fill: "#ffe5d0"
}

board.fabric.vga_pins -> vga: "analog RGB\n+ HS/VS"
input -> board.hps.usb: "USB"
